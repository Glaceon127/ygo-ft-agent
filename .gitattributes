# 统一换行，避免 Windows/Linux 互相 checkout 产生假 diff
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ydk   text eol=lf
*.txt   text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.lua   text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.flax_model  binary
*.cdb         binary
*.so          binary
*.png         binary
*.jpg         binary
*.gz          binary
*.zip         binary
